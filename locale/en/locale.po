msgid "plugins.themes.spupLightExplorerTheme.about.journalsIntro"
msgstr "The Light Explorer brings together specialized scholarly journals serving distinct academic disciplines within St. Paul University Philippines."

msgid "plugins.themes.spupLightExplorerTheme.about.structureEyebrow"
msgstr "Journal Identity"

msgid "plugins.themes.spupLightExplorerTheme.about.structure"
msgstr "One Network, Distinct Journals"

msgid "plugins.themes.spupLightExplorerTheme.about.structureOne"
msgstr "Each journal maintains its own aims and scope, editorial leadership, author guidelines, peer-review and editorial procedures, publication policies, announcements, issues and articles, and submission process."

msgid "plugins.themes.spupLightExplorerTheme.about.structureTwo"
msgstr "The Light Explorer provides the shared publishing and discovery environment without replacing each journal's individual scholarly identity."

