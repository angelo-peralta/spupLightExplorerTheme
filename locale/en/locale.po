msgid "plugins.themes.spupLightExplorerTheme.about.intro"
msgstr "The Light Explorer Journal Network is the scholarly publishing network of St. Paul University Philippines, bringing together the University's specialized academic journals within one publishing and discovery platform."

msgid "plugins.themes.spupLightExplorerTheme.about.history"
msgstr "History"

msgid "plugins.themes.spupLightExplorerTheme.about.story"
msgstr "Our Story"

msgid "plugins.themes.spupLightExplorerTheme.about.storyOne"
msgstr "The Light Explorer Journal Network evolved from The Light Explorer Multidisciplinary Journal, the earlier scholarly publication platform of St. Paul University Philippines."

msgid "plugins.themes.spupLightExplorerTheme.about.storyTwo"
msgstr "As the University's research and publication activities expanded across different academic disciplines, The Light Explorer developed into a network of specialized scholarly journals, each with its own disciplinary focus, editorial scope, policies, and publication identity."

msgid "plugins.themes.spupLightExplorerTheme.about.storyThree"
msgstr "Today, The Light Explorer serves as the unified journal network of St. Paul University Philippines, connecting these distinct journals through a common publishing and discovery platform while preserving the individual identity and academic focus of each publication."

msgid "plugins.themes.spupLightExplorerTheme.about.present"
msgstr "Present"

msgid "plugins.themes.spupLightExplorerTheme.about.whoWeAre"
msgstr "Who We Are"

msgid "plugins.themes.spupLightExplorerTheme.about.identity"
msgstr "The Light Explorer is SPUP's scholarly journal network. It provides a shared publishing environment and a common discovery gateway for distinct journals, rather than operating as one multidisciplinary journal."

msgid "plugins.themes.spupLightExplorerTheme.about.functionJournals"
msgstr "Discover SPUP journals"

msgid "plugins.themes.spupLightExplorerTheme.about.functionSearch"
